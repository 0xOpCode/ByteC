#!/bin/sh
# ==============================================================================
# ByteC: Automated Test Runner for College Labs (ctest)
# Forwards to bin/check for 4-layer verification and multi-case testing
# ==============================================================================

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -x "$SCRIPT_DIR/check" ]; then
    exec "$SCRIPT_DIR/check" "$@"
fi

if command -v check >/dev/null 2>&1; then
    exec check "$@"
fi

echo "Error: ByteC 'check' runner not found in $SCRIPT_DIR." >&2
exit 1
