#!/bin/sh
# ==============================================================================
# ByteC: Master Manager CLI and Interactive Studio Menu
# Usage: bytec [command]
# ==============================================================================

BYTEC_DIR="${BYTEC_HOME:-$HOME/.bytec}"
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)"
NVIM_DIR="${HOME}/.config/nvim"

if [ -d "$BYTEC_DIR/config/templates" ]; then
    TEMPLATE_DIR="$BYTEC_DIR/config/templates"
elif [ -d "$REPO_ROOT/config/templates" ]; then
    TEMPLATE_DIR="$REPO_ROOT/config/templates"
else
    TEMPLATE_DIR="$BYTEC_DIR/config/templates"
fi

get_version() {
    if [ -f "$BYTEC_DIR/VERSION" ]; then
        tr -d '[:space:]' < "$BYTEC_DIR/VERSION"
    elif [ -f "$REPO_ROOT/VERSION" ]; then
        tr -d '[:space:]' < "$REPO_ROOT/VERSION"
    else
        echo "2.0.0"
    fi
}

run_tool() {
    TOOL_NAME="$1"
    shift
    if [ -x "$SCRIPT_DIR/$TOOL_NAME" ]; then
        "$SCRIPT_DIR/$TOOL_NAME" "$@"
    elif [ -x "$BYTEC_DIR/bin/$TOOL_NAME" ]; then
        "$BYTEC_DIR/bin/$TOOL_NAME" "$@"
    else
        "$TOOL_NAME" "$@"
    fi
}

cmd_version() {
    echo "ByteC Version $(get_version)"
    echo "Platform: $(uname -s) $(uname -m)"
    if [ -n "$PREFIX" ] && [ -d "$PREFIX" ] && echo "$PREFIX" | grep -q "com.termux"; then
        echo "Environment: Native Android Termux"
    else
        echo "Environment: Standard Linux"
    fi
}

cmd_doctor() {
    echo "ByteC Environment Diagnostics (v$(get_version))"
    echo "----------------------------------------------"
    ERRORS=0
    WARNINGS=0

    # 1. Compiler (Clang)
    if command -v clang >/dev/null 2>&1; then
        CLANG_VER=$(clang --version 2>/dev/null | head -n 1)
        echo "Clang Compiler:  Installed ($CLANG_VER)"
    else
        echo "Clang Compiler:  Missing"
        echo "  Fix: pkg install clang"
        ERRORS=$((ERRORS + 1))
    fi

    # 2. C++ Compiler (Clang++)
    if command -v clang++ >/dev/null 2>&1; then
        echo "Clang++ (C++):   Installed"
    else
        echo "Clang++ (C++):   Missing"
        ERRORS=$((ERRORS + 1))
    fi

    # 3. Build Tools
    if command -v make >/dev/null 2>&1; then
        echo "Make:            Installed"
    else
        echo "Make:            Missing (Needed for Makefiles)"
        echo "  Fix: pkg install make"
        WARNINGS=$((WARNINGS + 1))
    fi

    if command -v cmake >/dev/null 2>&1; then
        echo "CMake:           Installed"
    else
        echo "CMake:           Missing"
        echo "  Fix: pkg install cmake"
        WARNINGS=$((WARNINGS + 1))
    fi

    # 4. Debugger (GDB)
    if command -v gdb >/dev/null 2>&1; then
        echo "GDB Debugger:    Installed"
    else
        echo "GDB Debugger:    Missing (Needed for debug / cdebug)"
        echo "  Fix: pkg install gdb"
        WARNINGS=$((WARNINGS + 1))
    fi

    # 5. Formatter (clang-format)
    if command -v clang-format >/dev/null 2>&1; then
        echo "clang-format:    Installed"
    else
        echo "clang-format:    Missing (Needed for fix / cformat)"
        echo "  Fix in Termux: pkg install clang"
        WARNINGS=$((WARNINGS + 1))
    fi

    # 6. Neovim IDE
    if command -v nvim >/dev/null 2>&1; then
        NV_VER=$(nvim --version 2>/dev/null | head -n 1)
        echo "Neovim IDE:      Installed ($NV_VER)"
    else
        echo "Neovim IDE:      Missing (Falls back to nano)"
        echo "  Fix: pkg install neovim"
        WARNINGS=$((WARNINGS + 1))
    fi

    # 7. Termux API
    if [ -n "$PREFIX" ] && [ -d "$PREFIX" ] && echo "$PREFIX" | grep -q "com.termux"; then
        if command -v termux-notification >/dev/null 2>&1; then
            echo "Termux API:      Installed"
        else
            echo "Termux API:      Missing (Optional for notifications/clipboard)"
            echo "  Fix: pkg install termux-api"
            WARNINGS=$((WARNINGS + 1))
        fi
    fi

    # 8. Git
    if command -v git >/dev/null 2>&1; then
        GIT_NAME=$(git config --global user.name 2>/dev/null)
        if [ -n "$GIT_NAME" ]; then
            echo "Git:             Configured (User: $GIT_NAME)"
        else
            echo "Git:             Installed, username not set"
            echo "  Fix: git config --global user.name \"Your Name\""
            WARNINGS=$((WARNINGS + 1))
        fi
    else
        echo "Git:             Missing"
        ERRORS=$((ERRORS + 1))
    fi

    # 9. Storage & Workspace
    if [ -d "$HOME/c_projects" ]; then
        TARGET=$(readlink -f "$HOME/c_projects" 2>/dev/null || echo "local")
        echo "Workspace:       ~/c_projects -> $TARGET"
    else
        echo "Workspace:       ~/c_projects missing"
        echo "  Fix: mkdir -p ~/c_projects"
        WARNINGS=$((WARNINGS + 1))
    fi

    # 10. Free disk space
    AVAIL_MB=$(df -m "$HOME" 2>/dev/null | awk 'NR==2 {print $4}')
    if [ -n "$AVAIL_MB" ]; then
        if [ "$AVAIL_MB" -gt 300 ]; then
            echo "Free Disk Space: ${AVAIL_MB}MB available"
        else
            echo "Free Disk Space: Low (${AVAIL_MB}MB available)"
            WARNINGS=$((WARNINGS + 1))
        fi
    fi

    echo "----------------------------------------------"
    if [ $ERRORS -eq 0 ] && [ $WARNINGS -eq 0 ]; then
        echo "Diagnostics pass. Ready to compile and run code."
    elif [ $ERRORS -eq 0 ]; then
        echo "Environment working with $WARNINGS recommendation(s)."
    else
        echo "Found $ERRORS critical issue(s) and $WARNINGS warning(s). Follow instructions above."
    fi
}

cmd_template() {
    NAME="$1"
    TARGET="$2"

    if [ -z "$NAME" ] || [ "$NAME" = "list" ] || [ "$NAME" = "-l" ]; then
        echo "Available Lab and DSA Templates (18):"
        echo "----------------------------------------------------------------"
        echo "  C Fundamentals & Lab Programs:"
        echo "    hello            - Hello World with command-line args"
        echo "    pointers         - Dynamic memory (malloc/free) and pointer swap"
        echo "    strings          - Custom string length, reverse, palindrome"
        echo "    recursion        - Factorial, Fibonacci, GCD, Tower of Hanoi"
        echo "    structures       - Student record struct array and sorting"
        echo "    matrix           - 2D matrix addition, multiplication, transpose"
        echo "    fileio           - File read, write, and line counting"
        echo ""
        echo "  Data Structures & Algorithms (C):"
        echo "    linkedlist       - Singly linked list (insert, delete, display)"
        echo "    doublylinkedlist - Doubly linked list forward/backward traversal"
        echo "    stack            - Array-based stack (push, pop, peek)"
        echo "    queue            - Circular queue implementation"
        echo "    binarytree       - Binary search tree (insert, search, traversals)"
        echo "    graph            - Graph BFS and DFS (adjacency list)"
        echo "    sort             - Bubble, Selection, and Insertion sorts"
        echo "    quicksort        - QuickSort and MergeSort divide-and-conquer"
        echo "    searching        - Linear search and iterative/recursive binary search"
        echo ""
        echo "  C++ & Object-Oriented Programming (.cpp):"
        echo "    stl              - C++20 STL containers (vector, map, set, sort)"
        echo "    oop              - C++ classes, inheritance, polymorphism"
        echo "----------------------------------------------------------------"
        echo "Usage: bytec template <name> [filename]"
        echo "Example: bytec template linkedlist lab2.c"
        echo "         bytec template stl demo.cpp"
        return
    fi

    TFILE=""
    DEF_EXT="c"
    if [ -f "$TEMPLATE_DIR/${NAME}.c" ]; then
        TFILE="$TEMPLATE_DIR/${NAME}.c"
        DEF_EXT="c"
    elif [ -f "$TEMPLATE_DIR/${NAME}.cpp" ]; then
        TFILE="$TEMPLATE_DIR/${NAME}.cpp"
        DEF_EXT="cpp"
    fi

    if [ -z "$TFILE" ]; then
        echo "Template '$NAME' not found."
        echo "Run 'bytec template list' to see available templates."
        return 1
    fi

    if [ -z "$TARGET" ]; then
        TARGET="${NAME}.${DEF_EXT}"
    fi

    if [ -f "$TARGET" ]; then
        echo "File '$TARGET' exists. Opening in editor..."
    else
        cp "$TFILE" "$TARGET"
        echo "Created '$TARGET' from template '$NAME'."
    fi

    mkdir -p "$BYTEC_DIR" 2>/dev/null || true
    T_DIR="$(cd "$(dirname "$TARGET")" 2>/dev/null && pwd)"
    [ -n "$T_DIR" ] && printf "%s/%s\n" "$T_DIR" "$(basename "$TARGET")" > "$BYTEC_DIR/.last_file" 2>/dev/null || true

    if [ "${BYTEC_NO_EDIT:-0}" = "1" ]; then
        return 0
    fi
    command -v nvim >/dev/null 2>&1 && exec nvim "$TARGET" || exec nano "$TARGET"
}

cmd_cheatsheet() {
    TOPIC="$1"
    case "$TOPIC" in
        printf|format)
            cat << 'EOF'
C Cheatsheet: printf and scanf Format Specifiers
----------------------------------------------
  %d, %i    Signed decimal integer (int)
  %u        Unsigned decimal integer (unsigned int)
  %f        Floating point number (float, double)
  %lf       Double precision float (double for scanf)
  %c        Single character (char)
  %s        String of characters (char*)
  %p        Pointer address (hexadecimal)
  %x, %X    Hexadecimal integer
  %%        Literal percent sign

Modifiers:
  %02d      Zero padded (e.g. 05)
  %.2f      Float rounded to 2 decimal places
EOF
            ;;
        pointers|ptr)
            cat << 'EOF'
C Cheatsheet: Pointers and Memory
----------------------------------------------
  int a = 10;
  int *p = &a;     // p stores address of a
  *p = 20;         // Dereference: changes a to 20

Dynamic Allocation (<stdlib.h>):
  int *arr = (int *)malloc(n * sizeof(int));
  int *arr = (int *)calloc(n, sizeof(int)); // Zero-initialized
  arr = (int *)realloc(arr, new_size * sizeof(int));
  free(arr);       // Free allocation
  arr = NULL;      // Clear dangling pointer
EOF
            ;;
        strings|str)
            cat << 'EOF'
C Cheatsheet: Common <string.h> Functions
----------------------------------------------
  strlen(s)        Length of string (excluding \0)
  strcpy(dest, src) Copy src into dest
  strncpy(dest, src, n) Copy up to n bytes
  strcat(dest, src) Append src to dest
  strcmp(s1, s2)   Compare strings (0 if equal)
  strchr(s, 'c')   Find first occurrence of char
  strstr(s, "sub") Find first occurrence of substring
EOF
            ;;
        loops|control)
            cat << 'EOF'
C Cheatsheet: Loops and Flow Control
----------------------------------------------
For Loop:
  for (int i = 0; i < n; i++) { ... }

While Loop:
  while (condition) { ... }

Do-While:
  do { ... } while (condition);

Switch Case:
  switch (choice) {
      case 1: ...; break;
      default: ...;
  }
EOF
            ;;
        dsa|structures)
            cat << 'EOF'
C Cheatsheet: Structs and Nodes
----------------------------------------------
Struct Definition:
  typedef struct Node {
      int data;
      struct Node *next;
  } Node;

Allocate Node:
  Node *newNode = (Node *)malloc(sizeof(Node));
  newNode->data = 10;
  newNode->next = NULL;
EOF
            ;;
        keys|neovim|nvim)
            cat << 'EOF'
ByteC Neovim Shortcuts
----------------------------------------------
  <Space> + r   Save, format (Allman), compile, and run
  Ctrl + s      Save current file
  Ctrl + z      Undo
  Ctrl + y      Redo
  Ctrl + Enter  Insert newline below
  Ctrl + d      Select word under cursor
  Ctrl + ~      Toggle floating terminal
  <Space> + e   Toggle file explorer tree
  <Space> + ff  Search files
EOF
            ;;
        *)
            echo "ByteC Offline C Guide"
            echo "----------------------------------------------"
            echo "Available topics:"
            echo "  bytec cheatsheet printf     - Format specifiers and modifiers"
            echo "  bytec cheatsheet pointers   - Pointers, malloc, free, realloc"
            echo "  bytec cheatsheet strings    - Standard string.h functions"
            echo "  bytec cheatsheet loops      - for, while, do-while, switch"
            echo "  bytec cheatsheet dsa        - Structs and linked list nodes"
            echo "  bytec cheatsheet keys       - Neovim editor shortcuts"
            echo "----------------------------------------------"
            ;;
    esac
}

cmd_profile() {
    mkdir -p "$BYTEC_DIR"
    PROFILE_FILE="$BYTEC_DIR/student_profile.conf"

    STUDENT_NAME=""
    ROLL_NO=""
    COLLEGE_NAME=""
    DEPARTMENT=""
    SEMESTER=""
    SUBJECT=""

    if [ -f "$PROFILE_FILE" ]; then
        # shellcheck disable=SC1090
        . "$PROFILE_FILE" 2>/dev/null || true
    fi

    echo "ByteC Student Profile Configuration"
    echo "Used by 'submit' when generating college lab records (.doc / .pdf)."
    echo "----------------------------------------------------------------"
    echo "  Current Name:       ${STUDENT_NAME:-Not set}"
    echo "  Current Roll No:    ${ROLL_NO:-Not set}"
    echo "  Current College:    ${COLLEGE_NAME:-Not set}"
    echo "  Current Department: ${DEPARTMENT:-Not set}"
    echo "  Current Semester:   ${SEMESTER:-Not set}"
    echo "  Current Subject:    ${SUBJECT:-Not set}"
    echo "----------------------------------------------------------------"

    printf "Student Name [%s]: " "${STUDENT_NAME}"
    read -r IN_NAME
    [ -n "$IN_NAME" ] && STUDENT_NAME="$IN_NAME"

    printf "Roll Number [%s]: " "${ROLL_NO}"
    read -r IN_ROLL
    [ -n "$IN_ROLL" ] && ROLL_NO="$IN_ROLL"

    printf "College / University [%s]: " "${COLLEGE_NAME}"
    read -r IN_COLLEGE
    [ -n "$IN_COLLEGE" ] && COLLEGE_NAME="$IN_COLLEGE"

    printf "Department / Branch [%s]: " "${DEPARTMENT}"
    read -r IN_DEPT
    [ -n "$IN_DEPT" ] && DEPARTMENT="$IN_DEPT"

    printf "Semester / Section [%s]: " "${SEMESTER}"
    read -r IN_SEM
    [ -n "$IN_SEM" ] && SEMESTER="$IN_SEM"

    printf "Default Subject / Lab [%s]: " "${SUBJECT}"
    read -r IN_SUBJ
    [ -n "$IN_SUBJ" ] && SUBJECT="$IN_SUBJ"

    cat << EOF > "$PROFILE_FILE"
STUDENT_NAME="$STUDENT_NAME"
ROLL_NO="$ROLL_NO"
COLLEGE_NAME="$COLLEGE_NAME"
DEPARTMENT="$DEPARTMENT"
SEMESTER="$SEMESTER"
SUBJECT="$SUBJECT"
EOF

    echo ""
    echo "Saved student profile to $PROFILE_FILE"
}

