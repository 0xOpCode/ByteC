cmd_notify() {
    TITLE="${1:-ByteC}"
    shift 2>/dev/null || true
    MESSAGE="${*:-Task completed in ByteC.}"

    if command -v termux-notification >/dev/null 2>&1; then
        termux-notification --title "$TITLE" --content "$MESSAGE" 2>/dev/null || true
        echo "Notification sent: $TITLE - $MESSAGE"
    else
        echo "Notice [$TITLE]: $MESSAGE"
        echo "(Install Termux:API app and 'pkg install termux-api' for Android system notifications)"
    fi
}

cmd_stats() {
    PROJ_DIR="$HOME/c_projects"
    echo "ByteC Workspace Statistics"
    echo "----------------------------------------------"
    if [ ! -d "$PROJ_DIR" ]; then
        echo "No projects directory found at ~/c_projects."
        return
    fi

    TOTAL_C=$(find "$PROJ_DIR" -type f -name "*.c" 2>/dev/null | wc -l)
    TOTAL_CPP=$(find "$PROJ_DIR" -type f \( -name "*.cpp" -o -name "*.cc" \) 2>/dev/null | wc -l)
    TOTAL_H=$(find "$PROJ_DIR" -type f -name "*.h" 2>/dev/null | wc -l)
    TOTAL_LINES=$(find "$PROJ_DIR" -type f \( -name "*.c" -o -name "*.cpp" -o -name "*.h" \) -exec cat {} + 2>/dev/null | wc -l)
    TOTAL_SIZE=$(du -sh "$PROJ_DIR" 2>/dev/null | awk '{print $1}')

    echo "  Total C files:      $TOTAL_C"
    echo "  Total C++ files:    $TOTAL_CPP"
    echo "  Total Header files: $TOTAL_H"
    echo "  Total Lines of Code: $TOTAL_LINES lines"
    echo "  Workspace Size:     $TOTAL_SIZE ($PROJ_DIR)"
    echo "----------------------------------------------"
}

cmd_share() {
    FILE="$1"
    if [ -z "$FILE" ] || [ ! -f "$FILE" ]; then
        echo "Error: Specify a file to share."
        echo "Usage: bytec share lab1.c"
        return 1
    fi

    echo "Uploading '$FILE' to paste service..."
    URL=""
    if command -v nc >/dev/null 2>&1; then
        URL=$(nc termbin.com 9999 < "$FILE" 2>/dev/null | tr -d '[:space:]\0')
    fi

    if [ -z "$URL" ] && command -v curl >/dev/null 2>&1; then
        URL=$(curl -s -F "clbin=@$FILE" https://clbin.com 2>/dev/null)
    fi

    if [ -n "$URL" ]; then
        echo "----------------------------------------------"
        echo "Link: $URL"
        if command -v termux-clipboard-set >/dev/null 2>&1; then
            echo "$URL" | termux-clipboard-set
            echo "Copied link to clipboard."
        fi
        echo "----------------------------------------------"
    else
        echo "Upload failed. Check your internet connection or install netcat: pkg install netcat-openbsd"
    fi
}

cmd_backup() {
    PROJ_DIR="$HOME/c_projects"
    DATE_STR=$(date "+%Y%m%d_%H%M%S")
    BACKUP_NAME="bytec_backup_${DATE_STR}.tar.gz"

    if [ ! -d "$PROJ_DIR" ]; then
        echo "Directory ~/c_projects not found."
        return 1
    fi

    DEST="$HOME/$BACKUP_NAME"
    if [ -d "/sdcard/Download/ByteC" ] && [ -w "/sdcard/Download/ByteC" ]; then
        DEST="/sdcard/Download/ByteC/$BACKUP_NAME"
    elif [ -d "/sdcard/Download" ] && [ -w "/sdcard/Download" ]; then
        DEST="/sdcard/Download/$BACKUP_NAME"
    elif [ -d "/sdcard" ] && [ -w "/sdcard" ]; then
        DEST="/sdcard/$BACKUP_NAME"
    fi

    echo "Archiving ~/c_projects to $DEST..."
    tar -czf "$DEST" -C "$HOME" "c_projects" 2>/dev/null

    if [ $? -eq 0 ]; then
        SIZE=$(ls -lh "$DEST" | awk '{print $5}')
        echo "Backup file created: $DEST ($SIZE)"
    else
        echo "Backup failed."
    fi
}

cmd_restore() {
    ARCHIVE="$1"
    if [ -z "$ARCHIVE" ] || [ ! -f "$ARCHIVE" ]; then
        echo "Error: Specify backup archive file (.tar.gz)"
        echo "Usage: bytec restore /sdcard/Download/bytec_backup_*.tar.gz"
        return 1
    fi

    echo "This unpacks projects into ~/c_projects."
    printf "Proceed? (y/n): "
    read -r CONFIRM
    case "$CONFIRM" in
        y|Y|yes)
            tar -xzf "$ARCHIVE" -C "$HOME"
            echo "Restored files to ~/c_projects"
            ;;
        *)
            echo "Cancelled."
            ;;
    esac
}

cmd_tutorial() {
    echo ""
    echo "================================================================"
    echo "ByteC 60-Second Quick Start Tutorial"
    echo "================================================================"
    echo "ByteC sets up C and C++ tools in native Termux."
    echo ""
    echo "Step 1: Create or edit a file"
    echo "  Run: code hello.c"
    echo "  Or with template: code lab1.c -t linkedlist"
    echo ""
    echo "Step 2: Compile and Run"
    echo "  Run: run"
    echo "  Or specify file: run hello.c"
    echo "  With automated input: run lab1.c -i input.txt"
    echo "  Or inside Neovim press: <Space> + r"
    echo ""
    echo "Step 3: Explain, Check, Fix, and Submit"
    echo "  Explain errors:   explain"
    echo "  Check and test:   check hello.c"
    echo "  Format and fix:   fix hello.c"
    echo "  Generate report:  submit hello.c"
    echo "  Interactive C:    learn"
    echo ""
    echo "Step 4: Sharing and Diagnostics"
    echo "  Share with link:  bytec share hello.c"
    echo "  Backup files:     bytec backup"
    echo "  Check setup:      bytec doctor"
    echo "================================================================"
    echo ""
}

cmd_uninstall() {
    echo "ByteC Uninstallation"
    echo "----------------------------------------------"
    echo "This removes ByteC CLI commands and shell configuration."
    echo "Your code in ~/c_projects remains on disk."
    echo ""
    printf "Remove ByteC? (y/n): "
    read -r CONFIRM
    case "$CONFIRM" in
        y|Y|yes)
            echo "Removing ByteC files..."
            BIN_DIR="$PREFIX/bin"
            [ ! -d "$BIN_DIR" ] && BIN_DIR="${HOME}/.local/bin"
            for cmd in gcc g++ cnew crun cbuild cformat cdebug ctest bytec code run explain check fix submit learn debug; do
                rm -f "$BIN_DIR/$cmd" 2>/dev/null
                rm -f "${HOME}/.local/bin/$cmd" 2>/dev/null
            done

            for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
                if [ -f "$rc" ]; then
                    sed -i '/# >>> ByteC Integration >>>/,/# <<< ByteC Integration <<</d' "$rc" 2>/dev/null || true
                fi
            done

            rm -rf "$BYTEC_DIR"

            echo "ByteC removed."
            echo "Your code remains intact at ~/c_projects."
            ;;
        *)
            echo "Uninstallation cancelled."
            ;;
    esac
}

cmd_update() {
    echo "Checking for updates..."

    if [ -d "$BYTEC_DIR/.git" ]; then
        echo "Updating ByteC tools..."
        git -C "$BYTEC_DIR" pull --ff-only || true
    fi

    if [ -d "$NVIM_DIR/.git" ]; then
        echo "Updating Neovim configuration..."
        git -C "$NVIM_DIR" pull --ff-only || true
        command -v nvim >/dev/null 2>&1 && nvim --headless "+Lazy sync" +qa >/dev/null 2>&1 || true
    fi

    mkdir -p "$BYTEC_DIR"
    date +%s > "$BYTEC_DIR/.last_check"

    echo "Update complete. Version $(get_version)"
}

cmd_status() {
    echo "ByteC Environment Status (v$(get_version))"
    echo "----------------------------------------------"
    echo "Clang version:  $(clang --version 2>/dev/null | head -n 1 || echo 'Not installed')"
    echo "Make version:   $(make --version 2>/dev/null | head -n 1 || echo 'Not installed')"
    echo "CMake version:  $(cmake --version 2>/dev/null | head -n 1 || echo 'Not installed')"
    echo "GDB version:    $(gdb --version 2>/dev/null | head -n 1 || echo 'Not installed')"
    echo "Neovim version: $(nvim --version 2>/dev/null | head -n 1 || echo 'Not installed')"
    echo "----------------------------------------------"
    if [ -d "$NVIM_DIR/.git" ]; then
        NVIM_COMMIT=$(git -C "$NVIM_DIR" rev-parse --short HEAD 2>/dev/null)
        echo "Neovim Commit:  $NVIM_COMMIT (0xOpCode/nvim)"
    fi
    if [ -d "$HOME/c_projects" ]; then
        echo "Workspace:      ~/c_projects -> $(readlink -f "$HOME/c_projects" 2>/dev/null || echo 'local')"
    fi
    if [ -f "$BYTEC_DIR/.last_file" ]; then
        echo "Last File:      $(head -n 1 "$BYTEC_DIR/.last_file" 2>/dev/null)"
    fi
}

cmd_check_silent() {
    mkdir -p "$BYTEC_DIR"
    LAST_CHECK=$(cat "$BYTEC_DIR/.last_check" 2>/dev/null || echo 0)
    NOW=$(date +%s)
    if [ $((NOW - LAST_CHECK)) -gt 86400 ]; then
        date +%s > "$BYTEC_DIR/.last_check"
        if [ -d "$BYTEC_DIR/.git" ]; then
            git -C "$BYTEC_DIR" fetch origin main -q 2>/dev/null || true
            LOCAL=$(git -C "$BYTEC_DIR" rev-parse @ 2>/dev/null)
            REMOTE=$(git -C "$BYTEC_DIR" rev-parse @{u} 2>/dev/null)
            if [ -n "$LOCAL" ] && [ -n "$REMOTE" ] && [ "$LOCAL" != "$REMOTE" ]; then
                echo "ByteC update available. Run 'bytec update'."
            fi
        fi
    fi
}

cmd_git() {
    if ! command -v git >/dev/null 2>&1; then
        echo "Git is not installed."
        return 1
    fi

    CUR_NAME="$(git config --global user.name 2>/dev/null || true)"
    CUR_EMAIL="$(git config --global user.email 2>/dev/null || true)"

    echo "Git Identity Configuration:"
    echo "  Current Name:  ${CUR_NAME:-Not set}"
    echo "  Current Email: ${CUR_EMAIL:-Not set}"
    echo ""

    printf "Enter new name (press Enter to keep '%s'): " "$CUR_NAME"
    read -r NEW_NAME
    [ -n "$NEW_NAME" ] && git config --global user.name "$NEW_NAME"

    printf "Enter new email (press Enter to keep '%s'): " "$CUR_EMAIL"
    read -r NEW_EMAIL
    [ -n "$NEW_EMAIL" ] && git config --global user.email "$NEW_EMAIL"

    echo ""
    echo "Saved Git Identity:"
    echo "  Name:  $(git config --global user.name)"
    echo "  Email: $(git config --global user.email)"
}

cmd_help() {
    echo "ByteC CLI Commands (v$(get_version))"
    echo ""
    echo "Beginner Verbs:"
    echo "  code [file.c]              Create or edit C/C++ program (or template: -t stack)"
    echo "  run [file.c]               Compile and run current or specified program"
    echo "  explain [file.c]           Plain-English compiler and crash error tutor"
    echo "  check [file.c] [test.txt]  Run static checks, warnings, and test cases"
    echo "  fix [file.c]               Auto-format and repair common syntax issues"
    echo "  submit [file.c]            Generate Word (.doc) and PDF (.pdf) lab records"
    echo "  learn [lesson]             Interactive offline C programming lessons"
    echo "  debug [file.c]             Start guided GDB debugging session"
    echo ""
    echo "Power-User Aliases:"
    echo "  cnew, crun, cbuild, cformat, cdebug, ctest, gcc, g++"
    echo ""
    echo "Studio & Management:"
    echo "  bytec                      Launch interactive ByteC v2.0 Studio Menu"
    echo "  bytec doctor               Run diagnostic system check"
    echo "  bytec profile              Configure student profile for lab reports"
    echo "  bytec resources            View curated free C/C++/DSA/Linux learning links"
    echo "  bytec notify <title> [msg] Send Android notification via Termux:API"
    echo "  bytec template [name]      Browse and scaffold 18 lab/DSA templates"
    echo "  bytec cheatsheet [topic]   View offline C reference guide"
    echo "  bytec git                  Configure Git user name and email"
    echo "  bytec share <file.c>       Share code online with web link"
    echo "  bytec backup / restore     Backup or restore ~/c_projects"
    echo "  bytec stats                View file counts and workspace size"
    echo "  bytec tutorial             Interactive 60-second walkthrough"
    echo "  bytec status               Inspect compiler and tool versions"
    echo "  bytec update               Pull updates for ByteC and Neovim"
    echo "  bytec version              Show ByteC version"
    echo "  bytec uninstall            Remove ByteC installation"
}

cmd_studio_menu() {
    LAST_FILE_DISPLAY="None"
    if [ -f "$BYTEC_DIR/.last_file" ]; then
        LF=$(head -n 1 "$BYTEC_DIR/.last_file" 2>/dev/null)
        [ -n "$LF" ] && LAST_FILE_DISPLAY="$LF"
    fi

    echo "================================================================"
    echo "  ByteC v2.0 Studio Menu (Pocket C & C++ Environment)"
    echo "  Recent File: $LAST_FILE_DISPLAY"
    echo "================================================================"
    echo "  1. Create or Edit Program (code)"
    echo "  2. Compile & Run Last Program (run)"
    echo "  3. Explain Compiler/Crash Error (explain)"
    echo "  4. Check & Test Program (check)"
    echo "  5. Generate Lab Report .doc & .pdf (submit)"
    echo "  6. Browse 18 Lab & DSA Templates (template)"
    echo "  7. Interactive C Lessons (learn)"
    echo "  8. Free C/C++/Linux Learning Resources (resources)"
    echo "  9. System Doctor & Setup (doctor)"
    echo "  0. Exit"
    echo "================================================================"
    printf "Choose an option [0-9]: "
    read -r MENU_CHOICE || exit 0

    case "$MENU_CHOICE" in
        1)
            run_tool code
            ;;
        2)
            run_tool run
            ;;
        3)
            run_tool explain
            ;;
        4)
            run_tool check
            ;;
        5)
            run_tool submit
            ;;
        6)
            cmd_template list
            ;;
        7)
            run_tool learn
            ;;
        8)
            cmd_resources
            ;;
        9)
            cmd_doctor
            ;;
        0|q|Q|exit|"")
            exit 0
            ;;
        *)
            echo "Invalid choice '$MENU_CHOICE'. Run 'bytec help' for commands."
            exit 1
            ;;
    esac
}

case "$1" in
    "")
        cmd_studio_menu
        ;;
    menu|studio)
        cmd_studio_menu
        ;;
    doctor)
        cmd_doctor
        ;;
    version|-v|--version)
        cmd_version
        ;;
    template|tpl)
        shift
        cmd_template "$@"
        ;;
    cheatsheet|cheat)
        shift
        cmd_cheatsheet "$@"
        ;;
    profile)
        cmd_profile
        ;;
    resources|links)
        cmd_resources
        ;;
    notify)
        shift
        cmd_notify "$@"
        ;;
    stats)
        cmd_stats
        ;;
    share)
        shift
        cmd_share "$@"
        ;;
    backup)
        cmd_backup
        ;;
    restore)
        shift
        cmd_restore "$@"
        ;;
    tutorial|quickstart)
        cmd_tutorial
        ;;
    git)
        cmd_git
        ;;
    uninstall)
        cmd_uninstall
        ;;
    update)
        cmd_update
        ;;
    status)
        cmd_status
        ;;
    check)
        cmd_check_silent
        ;;
    help|-h|--help)
        cmd_help
        ;;
    *)
        echo "Unknown command: '$1'. Run 'bytec help' for available commands."
        exit 1
        ;;
esac
