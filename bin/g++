#!/bin/sh
# ==============================================================================
# ByteC: G++ Wrapper for Termux and Clang++
# Forwards college lab g++ commands to clang++ without recursion
# ==============================================================================

if [ "$1" = "--bytec-info" ]; then
    echo "ByteC G++ Wrapper -> forwarding to clang++"
    exit 0
fi

BYTEC_HOME="${BYTEC_HOME:-$HOME/.bytec}"
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"

CLANGXX_BIN=""
OLD_IFS="$IFS"
IFS=":"
for dir in $PATH; do
    if [ "$dir" != "$BYTEC_HOME/bin" ] && [ "$dir" != "$SCRIPT_DIR" ]; then
        if [ -x "$dir/clang++" ]; then
            CLANGXX_BIN="$dir/clang++"
            break
        fi
    fi
done
IFS="$OLD_IFS"

if [ -z "$CLANGXX_BIN" ]; then
    echo "Error: 'clang++' compiler is not installed." >&2
    if [ -n "$PREFIX" ] && [ -d "$PREFIX" ] && echo "$PREFIX" | grep -q "com.termux"; then
        echo "Run: pkg install clang" >&2
    else
        echo "Install clang++: sudo apt install clang" >&2
    fi
    exit 1
fi

exec "$CLANGXX_BIN" "$@"
